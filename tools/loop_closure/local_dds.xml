<?xml version="1.0" encoding="UTF-8"?>
<!-- Single-host pipeline only. All participating processes use this profile.
     Do not use the loopback MTU profile for sensors on another machine. -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces><NetworkInterface name="lo" multicast="false"/></Interfaces>
      <AllowMulticast>false</AllowMulticast>
      <MaxMessageSize>65500 B</MaxMessageSize>
      <FragmentSize>60000 B</FragmentSize>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>30</MaxAutoParticipantIndex>
      <Peers><Peer Address="127.0.0.1"/></Peers>
    </Discovery>
    <Internal>
      <SocketReceiveBufferSize min="4 MiB"/>
      <SocketSendBufferSize min="4 MiB"/>
    </Internal>
  </Domain>
</CycloneDDS>
