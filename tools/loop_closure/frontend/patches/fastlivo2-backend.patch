+void LIVMapper::publish_backend_frame()
+{
+  if (!backend_enabled_ || !feats_down_body || feats_down_body->empty()) return;
+  const double stamp = LidarMeasures.last_lio_update_time;
+  if (!std::isfinite(stamp) || stamp < 0) return;
+  nav_msgs::msg::Odometry odom;
+  odom.header.stamp = rclcpp::Time(slam_mode_ == LIVO ? backend_image_stamp_ns_ :
+      static_cast<int64_t>(std::llround(stamp * 1e9)));
+  odom.header.frame_id = "camera_init";
+  odom.child_frame_id = "backend_imu";
+  odom.pose.pose.position.x = _state.pos_end.x();
+  odom.pose.pose.position.y = _state.pos_end.y();
+  odom.pose.pose.position.z = _state.pos_end.z();
+  const Eigen::Quaterniond q(_state.rot_end);
+  odom.pose.pose.orientation.x = q.x(); odom.pose.pose.orientation.y = q.y();
+  odom.pose.pose.orientation.z = q.z(); odom.pose.pose.orientation.w = q.w();
+  // ROS orders position then rotation; IEKF orders rotation then position.
+  // This is the frontend covariance only, not a posterior graph covariance.
+  for (int r = 0; r < 6; ++r)
+    for (int c = 0; c < 6; ++c)
+      odom.pose.covariance[r*6+c] = _state.cov((r+3)%6, (c+3)%6);
+  backend_odom_pub_->publish(odom);
+  if ((backend_cloud_pub_->get_subscription_count() == 0 && backend_semantic_pub_->get_subscription_count() == 0) ||
+      (backend_last_cloud_ >= 0 && stamp-backend_last_cloud_ < backend_interval_)) return;
+  backend_last_cloud_ = stamp;
+  // Reuse deskewed/downsampled geometry. No extraction, registration, or wait.
+  // Evenly subsample to bound serialization; graph uses the IMU body frame.
+  pcl::PointCloud<pcl::PointXYZ> points;
+  const size_t count = feats_down_body->size();
+  const size_t keep = std::min(count, static_cast<size_t>(backend_max_points_));
+  points.reserve(keep);
+  for (size_t k = 0; k < keep; ++k) {
+    const auto &p = feats_down_body->points[k*count/keep];
+    const Eigen::Vector3d body = extR * Eigen::Vector3d(p.x, p.y, p.z) + extT;
+    if (!body.allFinite()) continue;
+    points.emplace_back(static_cast<float>(body.x()), static_cast<float>(body.y()), static_cast<float>(body.z()));
+  }
+  sensor_msgs::msg::PointCloud2 msg;
+  pcl::toROSMsg(points, msg);
+  msg.header.stamp = odom.header.stamp;
+  msg.header.frame_id = odom.child_frame_id;
+  backend_cloud_pub_->publish(msg);
+  // Semantic inference needs the dense deskewed scan and original reflectance,
+  // not the graph's uniformly subsampled geometry. Same acquisition timestamp.
+  // Export is opt-in by subscription, at the same bounded keyframe cadence.
+  if (backend_semantic_pub_->get_subscription_count() &&
+      backend_semantic_stamp_ == stamp && !backend_semantic_points_.empty()) {
+    pcl::PointCloud<pcl::PointXYZI> semantic;
+    semantic.reserve(backend_semantic_points_.size());
+    for (const auto &p : backend_semantic_points_.points) {
+      if (!std::isfinite(p.x) || !std::isfinite(p.y) || !std::isfinite(p.z) || !std::isfinite(p.intensity)) continue;
+      pcl::PointXYZI q;
+      q.x = p.x; q.y = p.y; q.z = p.z; q.intensity = p.intensity;
+      semantic.push_back(q);
+    }
+    sensor_msgs::msg::PointCloud2 sem_msg;
+    pcl::toROSMsg(semantic, sem_msg);
+    sem_msg.header.stamp = odom.header.stamp;
+    sem_msg.header.frame_id = "backend_lidar";
+    backend_semantic_pub_->publish(sem_msg);
+    backend_semantic_points_.clear();
+    backend_semantic_stamp_ = -1.;
+  }
+}
