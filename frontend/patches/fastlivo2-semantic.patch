+void VoxelMapManager::PrepareSemanticFrame(double stamp)
+{
+  semantic_stamp_=stamp;semantic_samples_.clear();semantic_decisions_.clear();
+  semantic_dynamic_count_=semantic_pending_count_=semantic_invalidated_count_=0;
+  if(!semantic_map_.config.enabled)return;
+  semantic_prior_R_=state_.rot_end;semantic_prior_t_=state_.pos_end;
+  std::vector<semantic_frontend::Sample> world;
+  for(const auto &p:*feats_down_body_) {
+    const V3D body=extR_*V3D(p.x,p.y,p.z)+extT_;
+    const auto tag=semantic_frontend::tagOf(p);
+    semantic_samples_.push_back({body,tag});
+    world.push_back({state_.rot_end*body+state_.pos_end,tag});
+  }
+  if(semantic_map_.config.dynamics || semantic_map_.config.visual_mask) {
+    double variance=std::max(0.,state_.cov.block<3,3>(3,3).trace()/3.);
+    // Rotation uncertainty increases world-point uncertainty with range.
+    double radius2=0.;for(const auto &s:semantic_samples_)radius2+=s.point.squaredNorm();
+    radius2/=std::max<std::size_t>(1,semantic_samples_.size());
+    variance+=std::max(0.,state_.cov.block<3,3>(0,0).trace()/3.)*radius2;
+    semantic_motion_.prepare(stamp,world,variance);
+    for(const auto &s:world) {
+      auto d=semantic_motion_.decision(s);semantic_decisions_.push_back(d);
+      semantic_dynamic_count_+=d.state==semantic_frontend::Motion::Moving;
+      semantic_pending_count_+=d.state==semantic_frontend::Motion::Unknown;
+    }
+    if(semantic_map_.config.dynamics)InvalidateSemanticMap();
+  }
+}
+
+void VoxelMapManager::InvalidateSemanticMap()
+{
+  std::function<void(VoxelOctoTree*)> visit=[&](VoxelOctoTree *node) {
+    if(!node)return;
+    auto tag=node->semantic_evidence_.dominant();
+    if(semantic_frontend::motionCandidate(tag)) {
+      for(const auto &r:semantic_motion_.invalidated)
+        if(r.label==tag.label && r.contains(node->plane_ptr_->center_)) {
+          node->semantic_invalid_=true;node->plane_ptr_->is_plane_=false;
+          ++semantic_invalidated_count_;break;
+        }
+    }
+    for(auto *child:node->leaves_)visit(child);
+  };
+  for(auto &[key,node]:voxel_map_)visit(node);
+}
